---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SolarSection from '../components/SolarSection.astro';
import AdvantagesSection from '../components/AdvantagesSection.astro';
import FutureBanner from '../components/FutureBanner.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
---

<BaseLayout title="Energia que move o seu futuro" description={company.description}>
	<Header />
	<main>
		<Hero />
		<SolarSection />
		<div class="section-bridge-cta">
			<a class="button section-bridge-cta__button" href="#simulador">
				Simular minha economia
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M12 5v14"></path>
					<path d="m6 13 6 6 6-6"></path>
				</svg>
			</a>
		</div>
		<AdvantagesSection />
		<FutureBanner />
		<BenefitsSection />
		<AboutSection />
		<HowItWorks />
		<ContactCTA />
	</main>
	<Footer />
</BaseLayout>
