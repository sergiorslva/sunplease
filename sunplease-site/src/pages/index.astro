---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, whatsappUrl } from '../data/company';
---

<BaseLayout
	title="Site em construção"
	description="Estamos preparando uma nova experiência da KingSun."
	bodyClass="coming-soon-page"
>
	<main id="conteudo" class="coming-soon">
		<div class="coming-soon__panel">
			<img src="/images/kingsun-logo-white-horizontal.png" alt={company.name} />
			<p class="coming-soon__eyebrow">Em breve</p>
			<h1>Estamos preparando uma nova experiência para você.</h1>
			<p>Enquanto finalizamos os últimos detalhes, fale com a KingSun pelo WhatsApp para simular sua economia com energia solar.</p>
			<div class="coming-soon__actions">
				<a class="button" href={whatsappUrl()} target="_blank" rel="noreferrer">Falar pelo WhatsApp</a>				
			</div>
		</div>
	</main>
</BaseLayout>
