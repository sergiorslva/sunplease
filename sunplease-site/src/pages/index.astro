---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SolarSection from '../components/SolarSection.astro';
import AdvantagesSection from '../components/AdvantagesSection.astro';
import FutureBanner from '../components/FutureBanner.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
---

<BaseLayout title="Energia que move o seu futuro" description={company.description}>
	<Header />
	<main>
		<Hero />
		<SolarSection />
		<AdvantagesSection />
		<FutureBanner />
		<BenefitsSection />
		<AboutSection />
		<HowItWorks />
		<ContactCTA />
	</main>
	<Footer />
</BaseLayout>
