---
import { steps } from "../data/content";
---

<section
	id="como-funciona"
	class="section process-section"
	aria-labelledby="process-title"
>
	<div class="container">
		<h2 id="process-title">Como funciona</h2>
		<ol class="steps">
			{
				steps.map((step) => (
					<li>
						<div>
							<div class="steps__icon">
								<img src={step.icon} alt="" loading="lazy" />
							</div>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
