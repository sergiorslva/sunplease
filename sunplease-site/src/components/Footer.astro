---
import { company } from '../data/company';
import { navigation } from '../data/content';
---

<footer class="site-footer"><div class="container footer__top"><a class="brand" href="#inicio"><img src="/images/sunplease-logo.png" alt="SunPlease" /></a><div><p>{company.email}</p><p>{company.phone}</p><p>{company.address}</p></div><div class="footer__links">{navigation.slice(0, 3).map((item) => <a href={item.href}>{item.label}</a>)}<a href={company.socialLinks.instagram} aria-label="Instagram da SunPlease">Instagram</a></div></div><div class="container footer__bottom"><span>© {new Date().getFullYear()} {company.name}. Todos os direitos reservados.</span><a href="#inicio">Voltar ao topo ↑</a></div></footer>
