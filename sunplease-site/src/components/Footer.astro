---
import { company } from '../data/company';

interface Props {
	logoSrc?: string;
}

const { logoSrc = '/images/kingsun-logo-black-horizontal.png' } = Astro.props;
---

<footer class="site-footer">
	<div class="container footer__top">
		<a class="brand" href="#inicio" aria-label={`${company.name} - inicio`}>
			<img src={logoSrc} alt={company.name} />
		</a>
		<div class="footer__contact">
			<p>{company.phone}</p>
			<p>(11) 3456-7890</p>
			<p>{company.email}</p>
		</div>
		<div class="footer__address">
			<p>Rua Exemplo, 123</p>
			<p>{company.address}</p>
		</div>
	</div>
</footer>
