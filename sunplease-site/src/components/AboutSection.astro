---
const pillars = [
	{
		title: 'Nossa História',
		text: 'Nascemos com o propósito de tornar a energia solar acessivel para mais brasileiros, combinando tecnologia, excelência e atendimento próximo.',
		icon: '/images/kingsun-layout/about-history.png',
	},
	{
		title: 'Nosso Propósito',
		text: 'Acelerar a transição para um futuro mais limpo e prospero, ajudando familias a economizar e viver melhor com a energia do sol.',
		icon: '/images/kingsun-layout/about-propose.png',
	},
	{
		title: 'Nosso Compromisso',
		text: 'Qualidade, transparência e relacionamento de longo prazo com nossos clientes, do primeiro contato ao pos-venda.',
		icon: '/images/kingsun-layout/about-compromise.png',
	},
	{
		title: 'Como Atuamos',
		text: 'Com um time de especialistas, parceiros de confiança e as melhores soluções do mercado para projetos residenciais em todo o Brasil.',
		icon: '/images/kingsun-layout/about-wework.png',
	},
] as const;
---

<section id="sobre" class="section about-section" aria-labelledby="about-title">
	<div class="container about-layout">
		<div class="about__intro">
			<div>
				<h2 id="about-title">Quem somos</h2>
				<p>Movidos pelo sol. Comprometidos com as pessoas.</p>
			</div>
			<p>Nascemos com o propósito de tornar a energia solar acessível para mais brasileiros, combinando tecnologia, excelência e atendimento próximo.</p>
		</div>
		<div class="values">
			{pillars.map((pillar) => (
				<article>
					<div class="values__icon" aria-hidden="true">
						<img src={pillar.icon} alt="" loading="lazy" />
					</div>
					<h3>{pillar.title}</h3>
					<p>{pillar.text}</p>
				</article>
			))}
		</div>
	</div>
</section>
