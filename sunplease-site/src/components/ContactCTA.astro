---
import { whatsappUrl } from "../data/company";
---

<section id="contato" class="contact-cta" aria-labelledby="contact-title">
    <div class="container contact-cta__inner">
        <div>
            <p class="eyebrow">VAMOS CONVERSAR?</p><h2 id="contact-title">
                Sua proxima economia comeca com um oi.
            </h2>
        </div><a
            class="button button--light"
            href={whatsappUrl()}
            target="_blank"
            rel="noreferrer"
            >Simular minha Economia <span aria-hidden="true">&#8599;</span></a>
    </div>
</section>
