---
import { navigation } from '../data/content';
import { company, whatsappUrl } from '../data/company';

interface Props {
	logoSrc?: string;
}

const { logoSrc = '/images/kingsun-logo-white-horizontal.png' } = Astro.props;
---

<header class="site-header">
	<div class="container header__inner">
		<a class="brand" href="#inicio" aria-label={`${company.name} - inicio`}><img src={logoSrc} alt={company.name} /></a>
		<button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">
			<span class="sr-only">Abrir menu</span><span></span><span></span>
		</button>
		<nav id="primary-navigation" class="primary-nav" aria-label="Navegacao principal">
			{navigation.map((item, index) => <a class:list={{ 'is-active': index === 0 }} href={item.href}>{item.label}</a>)}
			<a class="button button--small header__cta" href={whatsappUrl()} target="_blank" rel="noreferrer" aria-label="Fale pelo WhatsApp">
				<span>Fale pelo WhatsApp</span>
				<svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
					<path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.33 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01Zm-7.01 15.25h-.01a8.24 8.24 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.25-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.48-1.38-1.73-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.05 0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.19 3.7.59.25 1.04.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.48-.28Z" />
				</svg>
			</a>
			<a class="button button--small nav__mobile-cta" href="#simulador">Simular minha economia</a>
		</nav>		
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const nav = document.querySelector<HTMLElement>('.primary-nav');
	if (toggle && nav) {
		const close = () => { toggle.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); };
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			toggle.setAttribute('aria-expanded', String(open));
			nav.classList.toggle('is-open', open);
		});
		nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
		document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
	}
</script>
