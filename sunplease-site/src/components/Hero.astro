---
import { whatsappUrl } from '../data/company';
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
	<div class="hero__sun" aria-hidden="true"></div>
	<div class="container hero__grid" id="conteudo">
		<div class="hero__content">
			<p class="hero__kicker">Da placa no telhado <br> ao carregador do seu carro</p>
			<h1 id="hero-title">O sol para todos!</h1>
			<a class="button" href={whatsappUrl()} target="_blank" rel="noreferrer">Simular minha Economia</a>
			<small>Gratuitamente</small>
		</div>
		<div class="hero__art" role="img" aria-label="Carro eletrico em recarga ao lado de uma casa com energia solar"></div>
	</div>
</section>
