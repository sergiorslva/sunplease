---
import { benefits } from "../data/content";
---

<section
	id="beneficios"
	class="section benefits-section"
	aria-labelledby="benefits-title"
>
	<div class="container">
		<div class="benefits-heading">
			<h2 id="benefits-title">Por que KingSun</h2><p>
				Energia boa se sente em cada escolha.
			</p>
		</div>
		<div class="benefit-grid">
			{
				benefits.map((benefit) => (
					<article class="benefit-card">
						<div class="benefit-card__top">
							<img src={benefit.icon} alt="" loading="lazy" />
						</div>
						<h3>{benefit.title}</h3>
						<p>{benefit.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
